# ============================================================
# Swing Trader Platform — Backend Environment Variables
# Copy this to .env.local and fill in values
# ============================================================

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (local dev)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/swingtrader?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swingtrader
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Scanner settings
MAX_STOCKS_PER_SCAN=100
USE_NIFTY500=false

# Azure (production only)
# DATABASE_URL="postgresql://adminuser:password@yourserver.postgres.database.azure.com:5432/swingtrader?sslmode=require"
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
