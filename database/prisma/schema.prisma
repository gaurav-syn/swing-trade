// =============================================================================
// Swing Trader Platform — Prisma Schema
// PostgreSQL | Prisma ORM | Production-grade
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum TradeType {
  LONG
  SHORT
}

enum Exchange {
  NSE
  BSE
}

enum SignalStrength {
  WEAK
  MODERATE
  STRONG
  VERY_STRONG
}

enum ScannerStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AlertType {
  PRICE_TARGET
  STOP_LOSS
  TRAILING_STOP
  VOLUME_SPIKE
  SCANNER_SIGNAL
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISMISSED
}

enum UserRole {
  ADMIN
  TRADER
  VIEWER
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole  @default(TRADER)
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  // Relations
  portfolio         Portfolio?
  trades            Trade[]
  scannerRuns       ScannerRun[]
  watchlists        Watchlist[]
  alerts            Alert[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  isRevoked   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================================================================
// PORTFOLIO
// =============================================================================

model Portfolio {
  id                    String   @id @default(cuid())
  userId                String   @unique
  initialCapital        Decimal  @db.Decimal(15, 2)
  currentCapital        Decimal  @db.Decimal(15, 2)
  availableCapital      Decimal  @db.Decimal(15, 2)
  totalInvested         Decimal  @db.Decimal(15, 2) @default(0)
  totalRealizedPnl      Decimal  @db.Decimal(15, 2) @default(0)
  totalUnrealizedPnl    Decimal  @db.Decimal(15, 2) @default(0)
  totalBrokerage        Decimal  @db.Decimal(15, 2) @default(0)
  totalTaxes            Decimal  @db.Decimal(15, 2) @default(0)
  totalTrades           Int      @default(0)
  winningTrades         Int      @default(0)
  losingTrades          Int      @default(0)
  maxDrawdown           Decimal  @db.Decimal(8, 4) @default(0)
  peakCapital           Decimal  @db.Decimal(15, 2) @default(0)
  riskPerTrade          Decimal  @db.Decimal(5, 2) @default(2)
  maxOpenTrades         Int      @default(5)
  maxPortfolioRisk      Decimal  @db.Decimal(5, 2) @default(10)
  dailyLossLimit        Decimal  @db.Decimal(5, 2) @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics             PortfolioAnalytics[]
  riskMetrics           RiskMetrics[]

  @@map("portfolios")
}

model PortfolioAnalytics {
  id                  String   @id @default(cuid())
  portfolioId         String
  date                DateTime @db.Date
  openingCapital      Decimal  @db.Decimal(15, 2)
  closingCapital      Decimal  @db.Decimal(15, 2)
  dailyPnl            Decimal  @db.Decimal(15, 2) @default(0)
  dailyPnlPercent     Decimal  @db.Decimal(8, 4) @default(0)
  tradesOpened        Int      @default(0)
  tradesClosed        Int      @default(0)
  winningTrades       Int      @default(0)
  losingTrades        Int      @default(0)
  capitalUtilization  Decimal  @db.Decimal(8, 4) @default(0)
  createdAt           DateTime @default(now())

  portfolio           Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, date])
  @@index([portfolioId, date])
  @@map("portfolio_analytics")
}

model RiskMetrics {
  id                    String   @id @default(cuid())
  portfolioId           String
  calculatedAt          DateTime @default(now())
  currentExposure       Decimal  @db.Decimal(15, 2) @default(0)
  exposurePercent       Decimal  @db.Decimal(8, 4) @default(0)
  openTradesCount       Int      @default(0)
  dailyLossToday        Decimal  @db.Decimal(15, 2) @default(0)
  dailyLossPercent      Decimal  @db.Decimal(8, 4) @default(0)
  sectorExposure        Json?
  beta                  Decimal? @db.Decimal(8, 4)
  sharpeRatio           Decimal? @db.Decimal(8, 4)
  sortinoRatio          Decimal? @db.Decimal(8, 4)
  maxDrawdownPeriod     Decimal? @db.Decimal(8, 4)
  varDaily              Decimal? @db.Decimal(15, 2)

  portfolio             Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, calculatedAt])
  @@map("risk_metrics")
}

// =============================================================================
// TRADES
// =============================================================================

model Trade {
  id                  String      @id @default(cuid())
  userId              String
  symbol              String      @db.VarChar(20)
  exchange            Exchange    @default(NSE)
  companyName         String?
  tradeType           TradeType   @default(LONG)
  status              TradeStatus @default(OPEN)

  // Entry
  entryPrice          Decimal     @db.Decimal(12, 2)
  entryQuantity       Int
  entryDate           DateTime    @default(now())
  entryNotes          String?

  // Exit
  exitPrice           Decimal?    @db.Decimal(12, 2)
  exitQuantity        Int?
  exitDate            DateTime?
  exitNotes           String?

  // Risk levels
  stopLoss            Decimal?    @db.Decimal(12, 2)
  target1             Decimal?    @db.Decimal(12, 2)
  target2             Decimal?    @db.Decimal(12, 2)
  target3             Decimal?    @db.Decimal(12, 2)
  trailingStopPercent Decimal?    @db.Decimal(5, 2)

  // P&L (calculated)
  investedAmount      Decimal     @db.Decimal(15, 2)
  realizedPnl         Decimal?    @db.Decimal(15, 2)
  realizedPnlPercent  Decimal?    @db.Decimal(8, 4)
  unrealizedPnl       Decimal?    @db.Decimal(15, 2)
  brokerage           Decimal     @db.Decimal(10, 2) @default(0)
  taxes               Decimal     @db.Decimal(10, 2) @default(0)
  netPnl              Decimal?    @db.Decimal(15, 2)
  riskRewardRatio     Decimal?    @db.Decimal(8, 4)
  holdingDays         Int?

  // Scanner source
  scannerRunId        String?
  confidenceScore     Decimal?    @db.Decimal(5, 2)
  strategy            String?

  // Metadata
  tags                String[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scannerRun          ScannerRun? @relation(fields: [scannerRunId], references: [id])
  logs                TradeLog[]
  alerts              Alert[]

  @@index([userId, status])
  @@index([userId, symbol])
  @@index([userId, entryDate])
  @@index([symbol, exchange])
  @@map("trades")
}

model TradeLog {
  id          String   @id @default(cuid())
  tradeId     String
  action      String
  details     Json
  priceAt     Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@map("trade_logs")
}

// =============================================================================
// SCANNER
// =============================================================================

model ScannerRun {
  id                String        @id @default(cuid())
  userId            String
  status            ScannerStatus @default(PENDING)
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  totalScanned      Int           @default(0)
  opportunitiesFound Int          @default(0)
  errorMessage      String?
  parameters        Json?

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  results           ScannerResult[]
  trades            Trade[]

  @@index([userId, startedAt])
  @@map("scanner_runs")
}

model ScannerResult {
  id                  String         @id @default(cuid())
  scannerRunId        String
  symbol              String         @db.VarChar(20)
  exchange            Exchange       @default(NSE)
  companyName         String?
  sector              String?

  // Price data at scan time
  currentPrice        Decimal        @db.Decimal(12, 2)
  dayChangePercent    Decimal?       @db.Decimal(8, 4)
  volume              BigInt?
  avgVolume           BigInt?
  volumeRatio         Decimal?       @db.Decimal(8, 4)
  marketCap           Decimal?       @db.Decimal(20, 2)

  // Suggested trade parameters
  suggestedEntry      Decimal        @db.Decimal(12, 2)
  stopLoss            Decimal        @db.Decimal(12, 2)
  target1             Decimal        @db.Decimal(12, 2)
  target2             Decimal?       @db.Decimal(12, 2)
  riskRewardRatio     Decimal        @db.Decimal(8, 4)
  suggestedHoldDays   Int            @default(5)

  // Scores
  confidenceScore     Decimal        @db.Decimal(5, 2)
  signalStrength      SignalStrength  @default(MODERATE)
  trendScore          Decimal?       @db.Decimal(5, 2)
  momentumScore       Decimal?       @db.Decimal(5, 2)
  volumeScore         Decimal?       @db.Decimal(5, 2)
  patternScore        Decimal?       @db.Decimal(5, 2)

  // Technical indicators snapshot
  rsi                 Decimal?       @db.Decimal(8, 4)
  macd                Decimal?       @db.Decimal(12, 4)
  macdSignal          Decimal?       @db.Decimal(12, 4)
  ema20               Decimal?       @db.Decimal(12, 2)
  ema50               Decimal?       @db.Decimal(12, 2)
  ema200              Decimal?       @db.Decimal(12, 2)
  atr                 Decimal?       @db.Decimal(12, 4)
  superTrend          Decimal?       @db.Decimal(12, 2)
  superTrendDir       String?
  bbUpper             Decimal?       @db.Decimal(12, 2)
  bbLower             Decimal?       @db.Decimal(12, 2)
  bbMiddle            Decimal?       @db.Decimal(12, 2)

  // Patterns detected
  patterns            String[]
  strategy            String?
  reasoning           String?

  isTradeCreated      Boolean        @default(false)
  scannedAt           DateTime       @default(now())

  scannerRun          ScannerRun     @relation(fields: [scannerRunId], references: [id], onDelete: Cascade)

  @@index([scannerRunId])
  @@index([symbol, exchange])
  @@index([confidenceScore])
  @@map("scanner_results")
}

// =============================================================================
// WATCHLIST
// =============================================================================

model Watchlist {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WatchlistItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id            String    @id @default(cuid())
  watchlistId   String
  symbol        String    @db.VarChar(20)
  exchange      Exchange  @default(NSE)
  companyName   String?
  notes         String?
  alertPrice    Decimal?  @db.Decimal(12, 2)
  addedAt       DateTime  @default(now())

  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// =============================================================================
// MARKET DATA CACHE
// =============================================================================

model MarketDataCache {
  id            String   @id @default(cuid())
  symbol        String   @db.VarChar(20)
  exchange      Exchange @default(NSE)
  open          Decimal  @db.Decimal(12, 2)
  high          Decimal  @db.Decimal(12, 2)
  low           Decimal  @db.Decimal(12, 2)
  close         Decimal  @db.Decimal(12, 2)
  volume        BigInt
  adjustedClose Decimal? @db.Decimal(12, 2)
  date          DateTime @db.Date
  fetchedAt     DateTime @default(now())

  @@unique([symbol, exchange, date])
  @@index([symbol, exchange, date])
  @@map("market_data_cache")
}

// =============================================================================
// ALERTS
// =============================================================================

model Alert {
  id            String      @id @default(cuid())
  userId        String
  tradeId       String?
  symbol        String      @db.VarChar(20)
  exchange      Exchange    @default(NSE)
  alertType     AlertType
  status        AlertStatus @default(ACTIVE)
  targetPrice   Decimal?    @db.Decimal(12, 2)
  message       String?
  triggeredAt   DateTime?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade         Trade?      @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([symbol, status])
  @@map("alerts")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
